# --- Required ---

# Postgres in production (Render injects this automatically via render.yaml).
# SQLite for local dev: sqlite:///./demo.db
DATABASE_URL=sqlite:///./demo.db

# Long random string. Render generates one automatically via render.yaml.
JWT_SECRET_KEY=change-me

# Never true outside local preview — bypasses all authentication.
DEMO_MODE=false

# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGIN=http://localhost:3000

# --- Optional integrations (features degrade gracefully without them) ---

# Unlocks GPT-backed AI summaries + free-form assistant chat.
# OPENAI_API_KEY=

# Unlocks real outbound WhatsApp sending.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# Org the inbound WhatsApp bot answers for (id from the organizations table).
# WHATSAPP_DEFAULT_ORG_ID=

# --- Salesforce Marketing Cloud (SFMC) — Email + WhatsApp ---
# Set these to route Email (and WhatsApp) through SFMC. Create an
# installed package in SFMC with an API Integration component (Server-to-
# Server, client_credentials) to get the client id/secret and subdomain.
# SFMC_SUBDOMAIN=mcxxxxxxxxxxxxxxxxxxxx
# SFMC_CLIENT_ID=
# SFMC_CLIENT_SECRET=
# SFMC_ACCOUNT_ID=            # MID, only if targeting a specific business unit

# Transactional email: create a Transactional Send Definition in SFMC tied to
# an email asset that uses %%subject%% and %%body%% attributes.
# SFMC_EMAIL_DEFINITION_KEY=
# SFMC_FROM_EMAIL=noreply@yourdomain.com
# SFMC_FROM_NAME=Paarsiv Constructions

# WhatsApp: the message definition key for your SFMC WhatsApp channel.
# SFMC_WHATSAPP_DEFINITION_KEY=

# Provider selection: auto (default) | sfmc | twilio | logging
# MESSAGING_PROVIDER=auto
