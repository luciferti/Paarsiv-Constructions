# ---- Server ----
PORT=4000
NODE_ENV=development
# CORS origin of the web app (React dev server)
WEB_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wa_platform?schema=public"

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# ---- WhatsApp (Meta Cloud API) ----
# These are per-tenant in the DB; this is only a fallback for a single-tenant/dev setup.
META_GRAPH_VERSION=v21.0

# ---- AI (optional global fallbacks; real keys live per-tenant in DB) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
