# ---- Server ----
PORT=4000
NODE_ENV=development
# CORS origin of the web app (React dev server)
WEB_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wa_platform?schema=public"

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# ---- WhatsApp (Meta Cloud API) ----
# These are per-tenant in the DB; this is only a fallback for a single-tenant/dev setup.
META_GRAPH_VERSION=v21.0

# Public origin of THIS api — shown as the webhook callback URL and used by Meta.
# A localhost value can never receive a webhook.
PUBLIC_URL=http://localhost:4000

# Meta app used for Embedded Signup ("Connect with Facebook" in Settings →
# WhatsApp). Tenants can set their own in the UI; these are the fallback.
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=

# ---- AI (optional global fallbacks; real keys live per-tenant in DB) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
